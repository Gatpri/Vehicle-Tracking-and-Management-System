# Frontend Build Stage
FROM node:22-alpine AS builder

WORKDIR /app

# Copy package files
COPY vite-project/package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY vite-project/src ./src
COPY vite-project/public ./public
COPY vite-project/index.html ./
COPY vite-project/tsconfig*.json ./
COPY vite-project/vite.config.ts ./
COPY vite-project/eslint.config.js ./

# Vite inlines VITE_* values into the bundle at BUILD time, so they must be
# present now — not at container runtime. vite.config.ts points envDir at the
# repo root, which is one level above this WORKDIR, so the consolidated .env
# is placed there. Only VITE_-prefixed keys ever reach the browser bundle.
COPY .env /.env

# Build frontend
RUN npm run build

# Drop the secrets file so it never survives into any later layer.
RUN rm -f /.env

# Production Stage - Serve with nginx
FROM nginx:alpine

# Copy nginx config
COPY nginx.conf /etc/nginx/nginx.conf

# Copy built frontend from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
