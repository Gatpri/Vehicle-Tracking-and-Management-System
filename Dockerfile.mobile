# Mobile (Expo / React Native) — static web export served by nginx
#
# A container can't produce or run native Android/iOS binaries usefully, and
# shipping the 495MB node_modules dev server would defeat the point. What IS
# containerisable is the react-native-web build: `expo export` compiles app/
# into plain static assets, so the runtime image holds only the bundle.
FROM node:22-alpine AS builder

WORKDIR /app

COPY mobile/package*.json ./

# npm ci needs the lockfile; scripts are skipped because expo's postinstall
# targets native tooling that isn't present (and isn't needed) here.
RUN npm ci --ignore-scripts --no-audit --no-fund

COPY mobile/app ./app
COPY mobile/src ./src
COPY mobile/assets ./assets
COPY mobile/index.ts mobile/app.json mobile/babel.config.js mobile/tsconfig.json ./

# Expo inlines EXPO_PUBLIC_* values at BUILD time, the same way Vite inlines
# VITE_*. They are embedded in the JS bundle, so they must be present now and
# cannot be changed by setting `environment:` on the container later — changing
# any of them requires a rebuild. Only EXPO_PUBLIC_-prefixed keys reach the app.
#
# API_URL must be an address the BROWSER can reach, so it defaults to localhost
# rather than the compose-internal service name `backend`.
ARG EXPO_PUBLIC_API_URL=http://localhost
ARG EXPO_PUBLIC_FIREBASE_API_KEY=
ARG EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
ARG EXPO_PUBLIC_FIREBASE_PROJECT_ID=
ARG EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
ARG EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
ARG EXPO_PUBLIC_FIREBASE_APP_ID=
ARG EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
ARG EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
ARG EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

ENV EXPO_PUBLIC_API_URL=${EXPO_PUBLIC_API_URL}     EXPO_PUBLIC_FIREBASE_API_KEY=${EXPO_PUBLIC_FIREBASE_API_KEY}     EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=${EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN}     EXPO_PUBLIC_FIREBASE_PROJECT_ID=${EXPO_PUBLIC_FIREBASE_PROJECT_ID}     EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=${EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET}     EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=${EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID}     EXPO_PUBLIC_FIREBASE_APP_ID=${EXPO_PUBLIC_FIREBASE_APP_ID}     EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=${EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID}     EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=${EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID}     EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=${EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID}

# --output-dir is explicit because expo's default ("dist") has changed between
# SDK versions. `--platform web` restricts the export to the web bundle.
RUN npx expo export --platform web --output-dir /app/web-build


# ---------- Runtime ----------
FROM nginx:alpine

COPY --from=builder /app/web-build /usr/share/nginx/html

# expo-router is a client-side router: deep links like /booking have no file on
# disk, so unmatched paths must fall back to index.html or they 404 on refresh.
RUN printf 'server {\n\
  listen 80;\n\
  root /usr/share/nginx/html;\n\
  index index.html;\n\
  location / {\n\
    try_files $uri $uri.html $uri/ /index.html;\n\
  }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  # 127.0.0.1, not localhost: in this container `localhost` resolves to ::1
  # first and nginx listens on IPv4 only, so a localhost probe is refused and
  # the container is reported unhealthy while it is actually serving fine.
  CMD wget --quiet --tries=1 --spider http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
