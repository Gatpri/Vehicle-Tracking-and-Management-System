# ============================================================
# Single source of truth for every service in this project:
#   - backend_api (Node)   loads this via backend_api/env.js
#   - anpr_service (Python) loads this via python-dotenv
#   - frontend (Vite)      reads it via envDir in vite.config.ts
#   - docker compose       substitutes ${VAR} from this file automatically
# Copy .env.example to .env and fill in real values.
# ============================================================

# --- Core / runtime ---
PORT=3000
MONGODB_URI=mongodb://admin:password123@localhost:27017/myDatabase?authSource=admin
# JWT_SECRET: generate with: openssl rand -hex 32
JWT_SECRET=

# The session travels in an httpOnly cookie. Over plain http (localhost, a LAN
# IP) a Secure cookie is dropped by the browser and nothing can authenticate,
# so this stays false for local Docker. Set it to true once the site is served
# over HTTPS — that also switches SameSite to "none" for tunnel/cross-site use.
COOKIE_SECURE=false

# --- Public URLs — update these when using a Cloudflare tunnel ---
BACKEND_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
ANPR_SERVICE_URL=http://127.0.0.1:8000

# The three URLs above are for bare-metal dev (`npm run dev`), where Vite is
# on :5173 and the backend on :3000. Under Docker, nginx fronts everything on
# port 80, so compose uses these instead. Point them at a LAN IP, tunnel URL
# or real domain to let other devices click verification/payment links.
DOCKER_BACKEND_BASE_URL=http://localhost
DOCKER_FRONTEND_URL=http://localhost

# --- Email (Gmail SMTP) ---
GMAIL_USER=
# GMAIL_APP_PASSWORD: 16-char Google App Password, not your login password
GMAIL_APP_PASSWORD=

# --- Firebase Admin (backend) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# --- eSewa payments ---
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=
ESEWA_PAYMENT_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_CHECK_URL=https://rc.esewa.com.np/api/epay/transaction/status/
COMPANY_ESEWA_ID=

# --- Cloudinary media ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- ANPR service (Python) ---
ANPR_PORT=8000
# ANPR_WEIGHTS_DIR: absolute path to the YOLO weights folder
ANPR_WEIGHTS_DIR=
ROBOFLOW_API_KEY=
ROBOFLOW_PROJECT=8th-sem-proj
ROBOFLOW_VERSION=1

# --- LLM sentiment ---
GEMINI_API_KEY=
# MISTRAL_API_KEY: optional fallback for sentiment
MISTRAL_API_KEY=

# --- Frontend (Vite) — only VITE_* reach the browser bundle ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
