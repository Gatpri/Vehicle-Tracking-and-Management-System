# Backend API Service — Express + Socket.IO
#
# Installs from backend_api/package.docker.json, NOT the shared
# vite-project/package.json. The shared file lists frontend and backend deps
# together, so `npm ci` on it put React, Vite, TypeScript, ESLint, leaflet and
# sharp into a container that only ever runs Express.
FROM node:22-alpine AS deps

WORKDIR /app

COPY vite-project/backend_api/package.docker.json ./package.json

# --omit=dev skips devDependencies; --ignore-scripts skips postinstall build
# steps none of these 15 packages need in a container.
RUN npm install --omit=dev --ignore-scripts --no-audit --no-fund \
    && npm cache clean --force


# ---------- Runtime ----------
FROM node:22-alpine

# wget backs the healthcheck (compose calls it). Present in alpine's busybox
# already, so nothing extra is installed here.
WORKDIR /app

ENV NODE_ENV=production

COPY --from=deps /app/node_modules ./node_modules
COPY vite-project/backend_api/package.docker.json ./package.json

# Source last so a code change rebuilds only this layer, not the install above.
COPY vite-project/backend_api ./backend_api

# Run unprivileged. The node image ships a `node` user; the app only reads its
# own source and writes nothing to disk, so it needs no ownership beyond this.
USER node

# No .env is baked into the image: docker-compose injects every value via
# `environment:`, and backend_api/env.js treats real env vars as
# authoritative. Keeping secrets out of the image is also why .dockerignore
# excludes the root .env.

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:3000/health', (r) => {if (r.statusCode !== 200) throw new Error(r.statusCode)})"

CMD ["node", "backend_api/index.js"]
