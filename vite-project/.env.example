VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Local ANPR inference sidecar (vite-project/anpr_service). Defaults to
# http://127.0.0.1:8000 when unset.
ANPR_SERVICE_URL=
# Directory holding plate_detector.pt / char_reader.pt / char_unified.pt.
# Read by anpr_service/server.py, not by the Node backend.
ANPR_WEIGHTS_DIR=

# The company's own eSewa account — every top-up lands here as real money, and
# every withdrawal is paid out of it. Shown to users at checkout and to the
# accounting admin on the withdrawals page.
#
# IMPORTANT: this is a label, not a routing instruction. Where the money
# actually lands is decided by ESEWA_MERCHANT_CODE + ESEWA_SECRET_KEY, which
# eSewa issues for a specific merchant account. Set this to the eSewa ID that
# those credentials belong to, or the display will lie about the destination.
COMPANY_ESEWA_ID=9818091358